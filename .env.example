# .env.example — 복사해서 .env로 저장하고 값을 채운다. .env는 git에 올리지 않는다 (NF2003).

# SSAFY GMS 키 (OpenAI 호환 프록시). OpenAI 키를 직접 쓰려면 GMS_KEY 대신 OPENAI_API_KEY를 넣는다.
GMS_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=          # 다른 OpenAI 호환 주소를 쓸 때만

# KIPRIS Plus 서비스 키 (특허 검색·서지 상세)
KIPRIS_API_KEY=

# 위키백과 API User-Agent에 넣을 연락처 (이메일 등) — 위키미디어 API 정책
WIKI_CONTACT=

# (선택) Chroma 색인 저장 위치. Windows에서 프로젝트 경로에 한글이 있고 프로젝트 폴더 밖에서 실행해야 할 때만 영문 경로로 지정
# CHROMA_DIR=C:/patent_lab/chroma_db
