# .env.example — 복사해서 .env로 저장하고 값을 채운다. .env는 git에 올리지 않는다.
#
# LLM 키는 아래 셋 중 하나만 있으면 된다. 키 종류로 제공자가 정해진다 (src/config.py, src/env.py).
#   GEMINI_API_KEY  → Google Gemini, OpenAI 호환 주소 (무료 등급 있음 — 분당·일당 요청 한도는 수시로 바뀌니 확인)
#                     https://aistudio.google.com/apikey
#   OPENAI_API_KEY  → OpenAI 직접 (유료)
#   GMS_KEY         → SSAFY GMS 프록시 (교육 과정용)
GEMINI_API_KEY=
# OPENAI_API_KEY=
# GMS_KEY=
# OPENAI_BASE_URL=          # 다른 OpenAI 호환 주소를 쓸 때만

# 모델 — 비우면 제공자별 기본값 (Gemini: 둘 다 gemini-3.5-flash-lite — 3.5-flash는 무료 등급 일일 20회라 못 쓴다, OpenAI·GMS: gpt-4o-mini / gpt-4.1)
# CHAT_MODEL=gemini-3.5-flash-lite      # 검색어 추출·문서 선별·답변·청구항 해설·조건 탐색
# PRIOR_ART_MODEL=gemini-3.5-flash-lite # 선행기술 조사의 후보 선별·구성요소 대비 (유료 키면 상위 모델 권장: gpt-4.1 등)

# 임베딩 — Gemini 키를 쓰면 기본값이 local(sentence-transformers, CPU, 호출·비용 없음), 그 외는 openai.
# 모델을 바꾸면 색인을 처음부터 다시 만들어야 한다 (README '임베딩 모델 바꾸기').
# EMBEDDING_PROVIDER=local              # local | openai
# EMBEDDING_MODEL=BAAI/bge-m3           # local: Hugging Face 모델 이름 (처음 쓸 때 약 2.2GB 내려받음) / openai: text-embedding-3-small

# 무료 등급 한도 대응 — 비우면 Gemini는 분당 10회·재시도 10회·대비 순차 호출, 그 외는 제한 없음·재시도 2회·대비 5건 병렬
# LLM_RPM=10
# LLM_MAX_RETRIES=10
# COMPARE_WORKERS=1

# KIPRIS Plus 서비스 키 (특허 검색·서지 상세) — https://plus.kipris.or.kr
KIPRIS_API_KEY=

# 위키백과 API User-Agent에 넣을 연락처 (이메일 등) — 위키미디어 API 정책
WIKI_CONTACT=

# (선택) Chroma 색인 저장 위치. Windows에서 프로젝트 경로에 한글이 있고 프로젝트 폴더 밖에서 실행해야 할 때만 영문 경로로 지정
# CHROMA_DIR=C:/patent_lab/chroma_db
